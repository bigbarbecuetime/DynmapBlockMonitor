DYNMAP_URL=http://dynmap.elgeis.com:10102
WORLD_NAME=8302018
MAP_TYPE=flat2
# Minecraft server address for player count (Dynmap has players hidden on this server).
# Real game server is on port 10101 (per the _minecraft._tcp SRV record), not 25565.
MC_HOST=mc.elgeis.com
MC_PORT=10101

# Reach the viewer over Tailscale. Bound to this machine's tailnet address only,
# not 0.0.0.0 -- the viewer has no authentication, so this keeps it off the LAN.
VIEWER_BIND=100.120.225.1
