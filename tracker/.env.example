# Copy this file to ".env" and fill in your server's details, then `docker compose up -d`.

# --- Dynmap (chunk / map-tile changes) ---
DYNMAP_URL=http://your-server:8123
WORLD_NAME=world
MAP_TYPE=flat2

# --- Minecraft server (player count via Server List Ping) ---
# The host and port you connect to in-game. If the server hides a non-standard port
# behind an SRV record, look it up: nslookup -type=SRV _minecraft._tcp.<host>
MC_HOST=your-server
MC_PORT=25565

# --- Tracker behavior (optional; these are the defaults) ---
POLL_INTERVAL=10
# Saving tile images lets the viewer replay the map as it looked at the time,
# instead of showing the server's current tiles. They can get large.
SAVE_IMAGES=false
# HTTP_TIMEOUT=8

# --- Viewer (optional; the CSV viewer runs alongside the tracker) ---
# Set to true to run the tracker only and not serve the viewer at all.
HEADLESS=false
# Where to reach it. Loopback-only by default because the viewer has no
# authentication and the CSVs contain player names; use 0.0.0.0 to expose it.
VIEWER_PORT=8080
VIEWER_BIND=127.0.0.1
